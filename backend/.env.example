# Copy this file to .env and fill in your own values. Never commit .env.

# Supabase -- required. Get these from your Supabase project's
# Settings > API page. Use the service_role (or "secret") key here, NOT
# the anon/publishable key -- this runs server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

GEMINI_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
PRODUCTHUNT_TOKEN=
GITHUB_TOKEN=
